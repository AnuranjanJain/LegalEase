# Database URL — set to a PostgreSQL connection string for production.
# Defaults to local SQLite (sqlite:///./legalease.db) when not set.
# DATABASE_URL=postgresql://user:password@host:5432/legalease

# Application environment: development, testing, staging, production, or local
# Defaults to production if not set
ENVIRONMENT=development

# Test mode for controlled failure simulation
# WARNING: TEST_MODE cannot be enabled in production environment
# Set ENVIRONMENT=testing to enable test mode safely
# TEST_MODE=false

# Bytez API key - replace with a real key in your local .env (DO NOT commit)
BYTEZ_API_KEY=your_bytez_api_key_here

# Frontend dev URL used for CORS (default used in backend)
FRONTEND_URL=http://localhost:5173

# Secret key used for signing JWT authentication tokens
JWT_SECRET_KEY=gssoc26_super_secure_secret_key_change_me_in_production

# Allow developer mode API key authentication
ALLOW_DEV=false
# Developer API key — only used when ALLOW_DEV=true (must be false in production)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEV_API_KEY=change_me_to_secure_random_key


# Stub mode for offline local development fallback response generation
STUB_MODE=true

# Environment configuration
# Set to "development", "testing", "staging", or "production"
# Defaults to "production" for safety
# Test-specific behaviors are only enabled in non-production environments
ENVIRONMENT=development

# Test mode configuration
# Set to "true" or "1" to enable test-specific behavior in development/testing environments only
# This allows controlled failure simulation for testing authentication workflows
# WARNING: Test mode is automatically disabled in production regardless of this setting
TEST_MODE=false

# Test verification failure simulation configuration
# These settings only take effect when TEST_MODE=true and ENVIRONMENT is not "production"
#
# TEST_VERIFICATION_FAILURE_EMAILS: Comma-separated list of email addresses that trigger
# simulated verification email failures. Useful for testing error handling workflows.
# Example: TEST_VERIFICATION_FAILURE_EMAILS=test-fail@example.com,test2-fail@example.org
# Default: "" (no emails configured)
TEST_VERIFICATION_FAILURE_EMAILS=
#
# TEST_FAILURE_EMAIL_PATTERNS: Comma-separated list of email patterns that trigger
# simulated verification email failures. If an email contains any of these patterns,
# it will simulate a failure. Useful for testing pattern-based failure scenarios.
# Example: TEST_FAILURE_EMAIL_PATTERNS=fail,error,simulate
# Default: "fail" (maintains backward compatibility with existing tests)
TEST_FAILURE_EMAIL_PATTERNS=fail

# AI Model input limits
MAX_SIMPLIFY_INPUT_CHARS=10000

# Redis URL for distributed rate limiting across multiple workers
# When set, rate limiting state is shared across all application workers
# When not set, rate limiting falls back to process-local in-memory storage
# Format: redis://localhost:6379/0 or rediss://localhost:6379/0 for TLS
# REDIS_URL=redis://localhost:6379/0

# Global rate limiting configuration
# Rate limiting is NEVER disabled, even in test mode
# For automated testing, use elevated limits instead of disabling
RATE_LIMIT_PERIOD=60
RATE_LIMIT_KEY_CALLS=300
RATE_LIMIT_IP_CALLS=60

# Testing configuration with elevated rate limits for CI/CD
# Use these values in test environments to avoid rate limit interference
# while still ensuring middleware executes correctly
# ENVIRONMENT=testing
# TEST_MODE=true
# RATE_LIMIT_IP_CALLS=100000
# RATE_LIMIT_PERIOD=60

# Production safety settings for rate limiting
# REQUIRE_REDIS_IN_PRODUCTION: When enabled, logs an error if REDIS_URL is not set in production
# This is a warning only and does not prevent startup (use REDIS_FAIL_FAST for strict enforcement)
# REQUIRE_REDIS_IN_PRODUCTION=false

# REDIS_FAIL_FAST: When enabled, application will fail to start if Redis URL is configured but connection fails
# This ensures distributed rate limiting is available before accepting traffic
# REDIS_FAIL_FAST=false

